server {
    listen 80;
    root /usr/share/nginx/html;
    server_name _;
    index index.html;

    location /ipl-predict/ {
        proxy_pass ${BACKEND_URL}/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}